{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAABE Workflow Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "config"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "enum": [
              "trigger.manual",
              "trigger.webhook",
              "trigger.schedule",
              "action.http",
              "action.ai",
              "action.email",
              "action.transform",
              "logic.if",
              "logic.delay",
              "logic.end"
            ]
          },
          "config": {
            "type": "object"
          },
          "credentialRef": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sourceHandle": {
            "type": "string"
          }
        }
      }
    }
  }
}
